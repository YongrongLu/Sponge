# Copy to .env and fill in ONE option. Never commit .env.

# Option A: Vertex AI via Google Cloud Application Default Credentials (ADC)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Option B: Vertex AI API key, if your organisation permits keys
# GOOGLE_API_KEY=your-google-cloud-key

# Option C: Gemini API key from aistudio.google.com (remove the Vertex lines above)
# GEMINI_API_KEY=your-key

GEMINI_MODEL=gemini-3.5-flash
# MOCK=true   # fake labels, no Google calls
PORT=8080
