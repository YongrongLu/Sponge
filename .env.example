# Copy to .env and fill in ONE option. Never commit .env.

# Option A (easiest): Vertex AI + API key from Google Cloud console > Agent Platform > "Get API key"
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_API_KEY=paste-your-key-here

# Option B: Vertex AI via gcloud login (run: gcloud auth application-default login)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Option C: Gemini API key from aistudio.google.com (remove the Vertex line above)
# GEMINI_API_KEY=your-key

GEMINI_MODEL=gemini-3.8-flash
# MOCK=true   # fake labels, no Google calls
PORT=8080
# Leaderboard + badges live in the Informer app (counts only). Empty = off.
# INFORMER_APP_URL=https://wl333-feed-sponge.go.informer-apps.com
# App API key from the Informer app → Access → API keys → New key
# INFORMER_APP_KEY=
